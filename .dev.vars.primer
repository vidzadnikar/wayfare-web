# Skrivnosti in nastavitve za domači zagon zaledja (npx wrangler pages dev).
# Kopiraj v .dev.vars (ni v gitu). Na Cloudflaru iste vrednosti vpišeš v
# Pages → Settings → Variables and Secrets ali z
#     npx wrangler pages secret put IME --project-name wayfarestudio
# Vrednosti tu so le vzorec.
SESSION_SECRET=zamenjaj-z-dolgim-nakljucnim-nizom
OBVESTI_SECRET=zamenjaj-z-drugim-nakljucnim-nizom
ADMIN_EMAIL=tvoj.naslov@gmail.com
# pošiljatelj: potrjeni naslov pri Brevu (brez lastne domene ga Brevo prepiše v …@…brevosend.com)
EMAIL_FROM=tvoj.naslov@gmail.com
# brevo (privzeto, BREVO_API_KEY) | resend (RESEND_API_KEY, lastna domena) | dnevnik (doma: pošto le izpiše)
POSTA_PONUDNIK=dnevnik
# največ pošt na dan (Brevo brezplačno 300); kar je čez, čaka v vrsti do naslednjega dne
POSTA_DNEVNO=300
BREVO_API_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# naročnina na vloge (Stripe): skrivni ključ (sk_test_… doma, sk_live_… v živo),
# cena (price_…, 6,99 € na mesec) in skrivnost webhooka (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# le doma: lažni Stripe (zaledje/preizkus_stripe.py); v živo te vrstice ni
# STRIPE_API_URL=http://127.0.0.1:8799
# naslov strani v povezavah v pošti (privzeto izvor zahteve)
# STRAN_URL=https://wayfarestudio.pages.dev
